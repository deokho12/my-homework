{
  // 시드 스크립트 전용 tsconfig.
  //
  // 시드는 `frontend/src/mocks/fixtures/*.ts` 를 **직접 import** 한다
  // (docs/database/README.md §8.1 원칙 3 — "fixture 를 손으로 옮겨 적지 않는다").
  // fixture 들이 `@/config/stockImages`, `@/types/domain` 을 참조하므로
  // 그 별칭을 프론트엔드 소스로 매핑해 준다.
  //
  // 이 매핑을 backend/tsconfig.json 에 넣지 않은 이유: 서버 코드가 프론트엔드
  // 소스를 import 할 수 있게 되면 안 된다. 시드만 예외다.
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],

    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "strict": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["../../frontend/src/*"]
    }
  },
  // 프론트 fixture 는 **시드가 실제로 import 하는 것만** 넣는다. 전체 glob
  // (`fixtures/**/*.ts`)이면 시드와 무관한 fixture(`procedures.ts`·`trendingSearches.ts`
  // 처럼 화면 전용으로 남은 것)의 타입 오류가 **백엔드 게이트를 빨갛게 만든다** —
  // 2026-10-21(요청 14)에 시술 원본이 `seed/data/` 로 넘어오면서 실제로 그렇게 됐다.
  // import 된 파일은 glob 과 무관하게 함께 검사되므로, 좁혀도 검증은 그대로다.
  // (2026-10-22 요청서 15: `consultRequests.ts`·`notifications.ts` 가 빠졌다 — 원본이
  //  `seed/data/` 로 와서 시드가 더 이상 그 두 파일을 읽지 않는다. 프런트 쪽 두 파일은
  //  읽는 코드가 남지 않아 같은 작업에서 삭제됐다.)
  "include": [
    "seed.ts",
    "seed/**/*.ts",
    "../../frontend/src/mocks/fixtures/guides.ts",
    "../../frontend/src/mocks/fixtures/promotions.ts",
    "../../frontend/src/mocks/fixtures/qaPosts.ts"
  ]
}
