# =============================================================================
# 몰라몰라 백엔드 환경변수 — 이 파일을 `.env` 로 복사해서 쓰세요.
#   cp .env.example .env
# `.env` 는 gitignore 대상입니다 (.gitignore 참고).
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE_URL — Prisma datasource (backend/prisma/schema.prisma 의 datasource db)
# -----------------------------------------------------------------------------
# 현재 provider 는 sqlite 입니다. SQLite 는 파일 경로를 `file:` URL 로 받습니다.
# 상대 경로의 기준은 **schema.prisma 가 있는 디렉토리**(backend/prisma/)이므로,
# 아래 값은 backend/prisma/dev.db 를 가리킵니다.
# 이 파일은 .gitignore 에 들어 있습니다 — DB 파일을 커밋하지 마세요.
DATABASE_URL="file:./dev.db"

# PostgreSQL 로 이전할 때 (docs/database/README.md §7):
#   1) schema.prisma 의 provider 를 "postgresql" 로 바꾸고
#   2) 아래 형식으로 DATABASE_URL 을 교체한 뒤
#   3) 마이그레이션을 처음부터 재생성합니다 (`prisma migrate dev --name init_postgres`)
# DATABASE_URL="postgresql://mola:mola@localhost:5432/mola?schema=public"

# -----------------------------------------------------------------------------
# SEED_PASSWORD — 시드가 만드는 개발용 계정 19개의 공통 비밀번호 (평문)
# -----------------------------------------------------------------------------
# 시드는 이 값을 bcrypt(cost 12)로 해시해서 users.password_hash 에 넣습니다.
# 값이 비어 있으면 시드는 해시를 추측하지 않고 **중단**합니다
# (docs/database/README.md §8.3 — "해시를 시드 코드에 하드코딩하지 마세요").
# 개발/로컬 전용입니다. 운영 DB 에는 시드를 돌리지 마세요.
SEED_PASSWORD="molamola!dev1"

# SEED_TODAY (선택) — 시드의 "오늘". 상담 신청 7건과 프로모션 4건의 날짜를
# 이 날짜 기준 상대 오프셋으로 넣습니다 (docs/database/README.md §8.4, §8.5).
# 비워 두면 시드 실행 시각(UTC)을 씁니다. 형식: YYYY-MM-DD
# SEED_TODAY="2026-08-12"

# -----------------------------------------------------------------------------
# 서버
# -----------------------------------------------------------------------------
# HTTP 포트 (기본 3000). 프론트엔드 dev 서버는 5173 입니다.
PORT=3000

# development | test | production
NODE_ENV=development

# CORS 허용 오리진 (쉼표 구분). 프론트엔드 vite dev 서버 기본값을 넣어 둡니다.
CORS_ORIGIN="http://localhost:5173"

# -----------------------------------------------------------------------------
# JWT — 인증·인가 (docs/api/README.md §3)
# -----------------------------------------------------------------------------
# 두 키는 **기본값이 없습니다.** 값이 없거나 32자 미만이면 부팅이 실패합니다
# (기본 키가 있으면 그 키로 서명한 토큰이 어디서나 통하는 백도어가 됩니다).
# 서로 **다른 값**이어야 합니다 — 같으면 리프레시 토큰을 액세스 토큰으로 위조할 수 있습니다.
#
# 생성:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# 아래 값은 **개발용 예시**입니다. 운영에서는 반드시 새로 만들고 비밀 관리 도구에 넣으세요.
JWT_ACCESS_SECRET="EvoO8SBnb-VP6RRC5hRBGj880rgczduCkzOXS_tY3hBcmjtRQabqDycXdPFKW79J"
JWT_REFRESH_SECRET="_WPGhsASFzSKVK5NbU2bffNvVoXZ7duA5NazIAfcUGJfRbZksWT-UAX3cRtOyWkY"

# 토큰의 iss / aud 클레임. 환경마다 다르게 두면 스테이징 토큰이 운영에서 통하지 않습니다.
JWT_ISSUER="molamola-api"
JWT_AUDIENCE="molamola-app"

# 토큰 수명(초). 문서 기준값: 액세스 15분(900), 리프레시 30일(2592000).
# 액세스 토큰이 짧은 이유는 폐기 수단이 없기 때문입니다(무상태 검증).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# -----------------------------------------------------------------------------
# 리프레시 토큰 정리 배치 (docs/database/README.md §11.1)
# -----------------------------------------------------------------------------
# refresh_tokens 는 회전마다 행이 늘고, 소비된 행도 재사용 감지를 위해 만료 전에는
# 지우지 않습니다. 그래서 정리 배치가 필요합니다 (04:00 KST 하루 1회).
#
# 여러 인스턴스를 띄울 때 한 대만 돌리려면 나머지를 false 로 두세요.
# 허용값은 "true" / "false" 뿐입니다 (오타가 조용히 켜짐이 되지 않게).
REFRESH_TOKEN_CLEANUP_ENABLED=true
#
# 소비(회전)된 행을 며칠 뒤에 지울지. 0 이면 만료될 때까지 남깁니다.
# 이 기간이 곧 **재사용 감지가 가능한 기간**입니다 — 탈취된 토큰은 즉시 쓰이므로
# 7일이면 충분하다고 보고 기본값으로 두었습니다.
REFRESH_TOKEN_CONSUMED_RETENTION_DAYS=7
#
# 수동 실행: npm run tokens:cleanup [-- --keep-days=<N>] [--dry-run]
