# Kakao API keys — https://developers.kakao.com/console/app
# The VITE_ prefix is what makes these available in client code via import.meta.env.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# JavaScript key, used by the web Kakao Maps SDK (src/components/map/KakaoMap.tsx).
# Leave empty to render a "key not configured" message instead of a map.
VITE_KAKAO_MAP_JS_KEY=

# REST API key, used for Kakao Local address search (src/services/geocoding.ts).
# Leave empty to fall back to the deterministic mock address search.
VITE_KAKAO_REST_API_KEY=
