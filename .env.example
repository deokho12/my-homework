# Kakao Maps API keys — https://developers.kakao.com/console/app
# EXPO_PUBLIC_ prefix makes these available in client code via process.env (Expo's built-in mechanism).
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# JavaScript key, used by the web Kakao Maps SDK (and inside the native WebView fallback).
EXPO_PUBLIC_KAKAO_MAP_JS_KEY=

# Native app key, reserved for a future native Kakao Maps SDK integration (not used by the current
# WebView-based fallback, which reuses the JS key instead — see src/components/map/README.md).
EXPO_PUBLIC_KAKAO_MAP_NATIVE_KEY=
